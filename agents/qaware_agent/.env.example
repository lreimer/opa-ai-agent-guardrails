# Copy to .env and choose ONE of the two options below.

# Option 1: Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Option 2: Vertex AI (requires `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: override the Gemini model used by the agent
# QAWARE_AGENT_MODEL=gemini-3.8-flash

# Optional: use OPA's REST API instead of the default local WASM policy
# Start OPA with policy/agents/qaware/qaware_agent.rego before using the REST backend.
# QAWARE_OPA_BACKEND=rest
# QAWARE_OPA_URL=http://127.0.0.1:8181
# QAWARE_OPA_TIMEOUT_SECONDS=1.0
